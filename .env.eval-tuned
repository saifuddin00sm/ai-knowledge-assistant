# Tuned retrieval configuration, used to produce the second row of the eval
# table in the README. Copy over .env to reproduce:
#   cp .env.eval-tuned .env && docker compose down -v && docker compose up -d --build
#   make seed && make eval
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=60
HYBRID_SEARCH_ENABLED=true
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15
