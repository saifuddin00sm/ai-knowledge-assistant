# Copy to `.env`. Every value here is a default the code already uses, so an
# empty .env works; uncomment only what you want to change.
#
# The defaults are deliberately key-free: the project runs end to end with no
# API keys using the local hashing embedder and the deterministic fake LLM.
# Switch the two PROVIDER lines below to get real answers.

# ---------- app ----------
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# ---------- database ----------
# Host-side default. Inside docker compose the API uses `db:5432` instead.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:55432/rag
# Host ports published by docker compose. 55432 avoids colliding with a
# PostgreSQL already installed on the host.
DB_PORT=55432
API_PORT=8000
WEB_PORT=3000

# Where the browser reaches the API. Baked into the web bundle at build time,
# so changing it needs `docker compose up -d --build web`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------- http ----------
# Comma-separated origins for the frontend. 3001 is included because
# `next dev` falls back to it when 3000 is already in use.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Leave empty to disable auth. When set, all /api/v1 routes except /health
# require the `X-API-Key: <value>` header.
API_KEY=

# ---------- uploads ----------
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# ---------- chunking ----------
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100

# ---------- embeddings ----------
# hashing = local, offline, lexical (no key). openai = semantic (needs a key).
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=local-hashing-v1
# Must match the vector column width; changing it needs a new migration.
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=5

# For EMBEDDING_PROVIDER=openai use:
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=text-embedding-3-small
#   OPENAI_API_KEY=sk-...
OPENAI_API_KEY=

# ---------- llm ----------
# fake = deterministic offline stub. anthropic = Claude (needs a key).
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=4096
# low | medium | high | xhigh | max
LLM_EFFORT=low
# adaptive | disabled ('disabled' is rejected above 'high' effort)
LLM_THINKING=adaptive
LLM_TIMEOUT_SECONDS=120

# For LLM_PROVIDER=anthropic use:
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=

# ---------- retrieval ----------
RETRIEVAL_TOP_K=5
# Cosine-similarity floor. Below this a chunk is dropped, so an off-topic
# question ends up with no context and the API refuses instead of guessing.
RETRIEVAL_MIN_SCORE=0.15
CONTEXT_TOKEN_BUDGET=3000
# Fuse vector + Postgres full-text results with reciprocal rank fusion.
HYBRID_SEARCH_ENABLED=false
HYBRID_RRF_K=60

# ---------- conversation ----------
HISTORY_TURNS=4
HISTORY_TOKEN_BUDGET=800
QUERY_REWRITE_ENABLED=true

# ---------- tests ----------
# Integration tests need a real Postgres with pgvector. They are skipped when
# this is unset. `make test` sets it to the compose database automatically.
# TEST_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:55432/rag_test
TEST_DATABASE_URL=
